// DCNF-CRF depth pipeline — GOST-style flowchart (uzbek latin labels).
// Render: python docs/diagrams/render.py   (requires Graphviz `dot`)
digraph depth_crf {
  rankdir=TB;
  bgcolor="white";
  node  [fontname="Arial", fontsize=11, style="filled", penwidth=1.3];
  edge  [fontname="Arial", fontsize=10, color="#334155"];

  start [label="Boshlash",                 shape=oval,          fillcolor="#dcfce7", color="#15803d"];
  in    [label="Kirish: tasvir x",         shape=parallelogram, fillcolor="#ede9fe", color="#7c3aed"];
  slic  [label="SLIC → n superpiksel",     shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  pinit [label="p = 1",                    shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  c1    [label="p ≤ n ?",                  shape=diamond,       fillcolor="#ffedd5", color="#c2410c"];
  da    [label="z_p = DA_V2(p)",           shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  pinc  [label="p = p + 1",                shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  rpq   [label="R_pq = Σ βk·S⁽ᵏ⁾",         shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  amat  [label="A = I + D − R",            shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  c2    [label="A teskari?",               shape=diamond,       fillcolor="#ffedd5", color="#c2410c"];
  reg   [label="A ← A + εI",               shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  solve [label="y* = A⁻¹·z",               shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  gf    [label="Guided filter + blend",    shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  out   [label="Chiqish: chuqurlik y",     shape=parallelogram, fillcolor="#ede9fe", color="#7c3aed"];
  mc    [label="3D: marching cubes",       shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a"];
  end   [label="Tugadi",                   shape=oval,          fillcolor="#dcfce7", color="#15803d"];

  start -> in -> slic -> pinit -> c1;
  c1   -> da   [label="ha"];
  da   -> pinc;
  pinc -> c1;                       // loop back
  c1   -> rpq  [label="yo'q"];
  rpq  -> amat -> c2;
  c2   -> reg  [label="yo'q"];
  reg  -> solve;
  c2   -> solve [label="ha"];
  solve -> gf -> out -> mc -> end;
}
