# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.venv/
/.vevn/
/venv/
/env/
/.codex-tmp/

# testing
/coverage
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class

# generated data and ML artifacts
/dataset/
/model/*.pt
/model/*.pth
/model/*.ckpt
/dataset.zip
/fractal_3d_TZ.md

# generated documents and demos
*.docx
/docs/_*.ply
/docs/diagrams/out/
/docs/pipeline_demo/
/docs/splat360_demo/
/docs/splat360_demo2/
/docs/splat360_mandelbulb/
/docs/splat360_menger/

# assistant-only notes, not app/runtime files
/AGENTS.md
/CLAUDE.md
/fractal_3d/CLAUDE.md

# fractal_3d runtime artifacts
fractal_3d/output/
fractal_3d/logs/
fractal_3d/feedback_dataset/
fractal_3d/**/__pycache__/
